<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- xUnit v3 test projects are executables, not libraries -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- REQUIRED with Test.Sdk 18.x: these versions build an MTP runner. Without these three, the build errors (CS0017)
         and/or `dotnet test` silently runs zero tests. -->
    <GenerateProgramFile>false</GenerateProgramFile>
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1"/>
    <PackageReference Include="xunit.v3" Version="3.2.2"/>
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Reads generated PDFs back. Test-only, Apache-2.0. -->
    <PackageReference Include="PdfPig" Version="0.1.16"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FileExporter\FileExporter.csproj"/>
  </ItemGroup>

</Project>
